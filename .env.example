# Skool Course Extractor — env config
# Copy to .env and fill values.

# Notion integration token (internal integration with access to the parent page)
NOTION_API_TOKEN=

# Parent page in Notion where course pages are created (must be shared with the integration)
NOTION_AI_AD_ALCHEMISTS_PAGE_ID=3645dbbfbdae808ab4f4da4cf9c5bee4

# Path to a Chrome user-data-dir that's logged into Skool.
# Leave blank to use the default: ~/.config/skool-extractor/chrome-profile
# On first run the script creates this directory; log in inside that browser
# window once and the session persists.
SKOOL_CHROME_PROFILE=
